# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars

# ── Required ──────────────────────────────────────────────────
aws_region   = "us-east-1"
project_name = "myapp"          # lowercase, 3–20 chars, hyphens OK
environment  = "development"    # development | staging | production

# ── Networking (defaults are usually fine) ────────────────────
# vpc_cidr           = "10.0.0.0/16"
# availability_zones = ["us-east-1a", "us-east-1b"]
# public_subnets     = ["10.0.1.0/24", "10.0.2.0/24"]
# private_subnets    = ["10.0.11.0/24", "10.0.12.0/24"]
# single_nat_gateway = true       # set false for production HA

# ── Container ─────────────────────────────────────────────────
# container_port = 3000
# task_cpu       = 256            # 256 | 512 | 1024 | 2048 | 4096
# task_memory    = 512            # MiB
# desired_count  = 2

# ── Auto-scaling ──────────────────────────────────────────────
# autoscaling_min_capacity  = 1
# autoscaling_max_capacity  = 10
# autoscaling_cpu_target    = 60
# autoscaling_memory_target = 70

# ── HTTPS (optional) ──────────────────────────────────────────
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."

# ── Logging ───────────────────────────────────────────────────
# log_retention_days = 30
